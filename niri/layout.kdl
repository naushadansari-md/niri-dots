// ────────────── Layout Settings ──────────────

layout {
  
    gaps 8
    center-focused-column "never"
    empty-workspace-above-first
        
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
}

default-column-width   { proportion 0.5; }

focus-ring {
       // off
        on
        width 2
active-color "#6491AD"
// inactive-color "#958379"
active-gradient from="#6491AD" to="#79AAC1" angle=45 relative-to="workspace-view" in="oklch longer hue"
inactive-gradient from="#a59d89" to="#161714" angle=45 relative-to="workspace-view" in="oklch longer hue"
        
}


border {
        
        off
        // on
        width 2
active-color "#6491AD"
// inactive-color "#958379"
active-gradient from="#6491AD" to="#79AAC1" angle=45 relative-to="workspace-view" in="oklch longer hue"
inactive-gradient from="#a59d89" to="#161714" angle=45 relative-to="workspace-view" in="oklch longer hue"
urgent-color "#A58D71"

}

 
shadow {
       off
       // on
       draw-behind-window true
       softness 30
       spread 5
       offset x=0 y=5
       color "#00000070"
}

struts {
        // left 5
        // right 5
        // top 5
        // bottom 5
    }
}
