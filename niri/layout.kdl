// ────────────── Layout Settings ──────────────

layout {
  
    gaps 8
    center-focused-column "never"
    empty-workspace-above-first
        
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
}

default-column-width   { proportion 0.5; }

focus-ring {
        width 1
active-color "#B7856C"
// inactive-color "#958379"
active-gradient from="#B7856C" to="#D29674" angle=45 relative-to="workspace-view" in="oklch longer hue"
inactive-gradient from="#9e9187" to="#121012" angle=45 relative-to="workspace-view" in="oklch longer hue"
        
}


border {
        width 1
active-color "#B7856C"
// inactive-color "#958379"
active-gradient from="#B7856C" to="#D29674" angle=45 relative-to="workspace-view" in="oklch longer hue"
inactive-gradient from="#9e9187" to="#121012" angle=45 relative-to="workspace-view" in="oklch longer hue"
urgent-color "#6A5659"

}

 
shadow {
       on
       draw-behind-window false
       softness 30
       spread 5
       offset x=0 y=5
       color "#0007"
}

struts {
        // left 5
        // right 5
        // top 5
        // bottom 5
    }
}
