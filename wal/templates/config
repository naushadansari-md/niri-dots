# Mako colors generated by pywal

font=JetBrainsMono Nerd Font 10
background-color={background}
text-color={foreground}
border-color={color2}
progress-color=over {color3}

border-size=1
border-radius=6
default-timeout=5000
padding=12
anchor=bottom-right
margin=2
outer-margin=25

# ---- ICONS ----
icon-path=/usr/share/icons/hicolor:/usr/share/icons/Papirus:/usr/share/pixmaps
max-icon-size=48

# ---- GROUPING & STACKING ----
group-by=app-name,summary
sort=-time
layer=overlay

[urgency=low]
border-color={color2}

[urgency=normal]
border-color={color4}

[urgency=high]
border-color={color1}
background-color={color1}
text-color={background}

# ---- APP RULES ----

[app-name=wireplumber]
group-by=app-name
default-timeout=1500

[app-name=brightnessctl]
group-by=app-name
default-timeout=1500

[app-name=UPower]
group-by=app-name
default-timeout=4000

# ---- MEDIA PLAYERS ----

[app-name=Spotify]
group-by=app-name
default-timeout=2000

[app-name=mpv]
group-by=app-name
default-timeout=2000

[app-name=vlc]
group-by=app-name
default-timeout=2000

[app-name=org.mozilla.firefox]
group-by=app-name
default-timeout=2000

[app-name=google-chrome]
group-by=app-name
default-timeout=2000

# Generic MPRIS / media category
[category=transport]
group-by=app-name
default-timeout=1500


[mode=do-not-disturb]
invisible=1
